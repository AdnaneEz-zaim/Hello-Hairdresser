<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Registration">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        >
        <LinearLayout
            android:textAlignment="center"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/shape_logo"
                >

                <androidx.cardview.widget.CardView
                    android:id="@+id/view"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_centerHorizontal="true"
                    android:elevation="12dp"
                    android:background="@drawable/shape_logo"
                    android:textAlignment="center"
                    app:cardCornerRadius="60dp">

                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/shape_logo"
                        android:src="@drawable/adnane" />
                </androidx.cardview.widget.CardView>

                <ImageButton
                    android:id="@+id/imageDangerLevel3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginLeft="5dp"
                    android:padding="3dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/etat_shape"
                    android:translationZ="2dp"
                    android:src="@drawable/ic_camera"
                    android:backgroundTint="#EFE4E4"
                    />
            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20sp"
                android:layout_marginBottom="80sp"
                android:background="@drawable/shape_transparent"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginHorizontal="20dp"
                >
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/id_prenom_reg"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="50sp"
                        android:layout_marginHorizontal="15sp"
                        android:layout_marginTop="45sp"
                        android:background="@drawable/shape_input"
                        android:drawableLeft="@drawable/ic_person"
                        android:drawablePadding="10sp"
                        android:hint="votre prenom"
                        android:paddingHorizontal="15sp"
                        android:singleLine="true"
                        android:textColor="@android:color/black" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/id_nom_reg"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="50sp"
                        android:layout_marginHorizontal="15sp"
                        android:layout_marginTop="45sp"
                        android:background="@drawable/shape_input"
                        android:drawableLeft="@drawable/ic_person"
                        android:drawablePadding="10sp"
                        android:hint="votre nom"
                        android:paddingHorizontal="15sp"
                        android:singleLine="true"
                        android:textColor="@android:color/black"
                        />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/id_email_reg"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="50sp"
                        android:layout_marginHorizontal="15sp"
                        android:layout_marginTop="45sp"
                        android:background="@drawable/shape_input"
                        android:drawableLeft="@drawable/ic_email"
                        android:drawablePadding="10sp"
                        android:hint="votre email"
                        android:paddingHorizontal="15sp"
                        android:singleLine="true"
                        android:textColor="@android:color/black"
                        />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/id_phone_reg"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="50sp"
                        android:layout_marginHorizontal="15sp"
                        android:layout_marginTop="45sp"
                        android:background="@drawable/shape_input"
                        android:drawableLeft="@drawable/ic_phone"
                        android:drawablePadding="10sp"
                        android:hint="votre numero"
                        android:paddingHorizontal="15sp"
                        android:singleLine="true"
                        android:textColor="@android:color/black"
                        />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/id_adresse_reg"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="50sp"
                        android:layout_marginHorizontal="15sp"
                        android:layout_marginTop="45sp"
                        android:background="@drawable/shape_input"
                        android:drawableLeft="@drawable/ic_location"
                        android:drawablePadding="10sp"
                        android:hint="votre adresse"
                        android:paddingHorizontal="15sp"
                        android:singleLine="true"
                        android:textColor="@android:color/black"
                        />
                </com.google.android.material.textfield.TextInputLayout>                        android:background="@drawable/shape_input"
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/id_password_reg"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="50sp"
                        android:layout_marginHorizontal="15sp"
                        android:layout_marginTop="45sp"
                        android:background="@drawable/shape_input"
                        android:drawableLeft="@drawable/ic_lock"
                        android:drawablePadding="10sp"
                        android:hint="votre adresse"
                        android:inputType="textPassword"
                        android:paddingHorizontal="15sp"
                        android:singleLine="true"
                        android:textColor="@android:color/black"
                        />
                </com.google.android.material.textfield.TextInputLayout>                        android:background="@drawable/shape_input"
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/id_confPassword_reg"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="50sp"
                        android:layout_marginHorizontal="15sp"
                        android:layout_marginTop="45sp"
                        android:background="@drawable/shape_input"
                        android:drawableLeft="@drawable/ic_lock"
                        android:drawablePadding="10sp"
                        android:hint="votre adresse"
                        android:inputType="textPassword"
                        android:paddingHorizontal="15sp"
                        android:singleLine="true"
                        android:textColor="@android:color/black"
                        />
                </com.google.android.material.textfield.TextInputLayout>                        android:background="@drawable/shape_input"

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35sp"
                    >
                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyle"
                        android:layout_width="match_parent"
                        android:indeterminateTint="@color/vertApp"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/singUp_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="40sp"
                        android:layout_marginBottom="20sp"
                        android:background="@drawable/shape_button"
                        android:backgroundTint="@color/vertApp"
                        android:text="CREER UN COMPTE"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="18sp" />
                </RelativeLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vous avez déja un compte ?"
                        />
                    <TextView
                        android:id="@+id/dejaCreeBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10sp"
                        android:textColor="@color/vertApp"
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:text="Connectez-vous"
                        />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>