<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Login">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:textAlignment="center">

            <ImageView
                android:layout_width="150sp"
                android:layout_height="150sp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/shape_logo"
                android:src="@drawable/logo_app" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20sp"
                android:layout_marginBottom="80sp"
                android:background="@drawable/shape_transparent"
                android:orientation="vertical"
                android:padding="20dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/id_email"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="50sp"
                        android:layout_marginHorizontal="15sp"
                        android:layout_marginTop="45sp"
                        android:background="@drawable/shape_input"
                        android:drawableLeft="@drawable/ic_email"
                        android:drawablePadding="10sp"
                        android:hint="votre email"
                        android:paddingHorizontal="15sp"
                        android:singleLine="true"
                        android:textColor="@android:color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/id_phone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="50sp"
                        android:layout_marginHorizontal="15sp"
                        android:layout_marginTop="45sp"
                        android:background="@drawable/shape_input"
                        android:drawableLeft="@drawable/ic_lock"
                        android:drawablePadding="10sp"
                        android:hint="votre numero"
                        android:paddingHorizontal="15sp"
                        android:singleLine="true"
                        android:textColor="@android:color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="35sp"
                        android:indeterminateTint="@color/vertApp" />

                    <Button
                        android:id="@+id/goToHome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="80sp"
                        android:layout_marginTop="35sp"
                        android:layout_marginBottom="20sp"
                        android:background="@drawable/shape_button"
                        android:backgroundTint="@color/vertApp"
                        android:text="CONNEXION"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="18sp" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vous n'avez pas de compte?" />

                    <TextView
                        android:id="@+id/newAcompteBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10sp"
                        android:text="crée un"
                        android:textColor="@color/vertApp"
                        android:textSize="16dp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>